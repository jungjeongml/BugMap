# Origin exposed by your HTTPS reverse proxy. Use the same origin in the app.
AUTH_PUBLIC_ORIGIN=https://auth-dev.example.com
PORT=3000
AUTH_DB_PATH=./.bugmap-auth.sqlite3

# Kakao REST API key and its client secret.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Google OAuth Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Services ID, Team ID, Sign in with Apple key ID and PKCS#8 .p8 contents.
# Paste the key on one line with literal \n between the PEM lines, inside single quotes.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
