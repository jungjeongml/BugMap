{
  "name": "bugmap-auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13 || >=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.mjs",
    "test": "npm run build && node --env-file-if-exists=.env --test test/*.test.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.15",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.12.2",
    "@types/pg": "8.15.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
