# Published public HTTPS policy document URLs. Leave blank until published.
EXPO_PUBLIC_BUGMAP_TERMS_URL=
EXPO_PUBLIC_BUGMAP_PRIVACY_URL=

# HTTPS origin of the BugMap auth server. Use a native app build for the bugmap:// callback.
EXPO_PUBLIC_BUGMAP_AUTH_API_URL=

# Optional public Mapbox token (pk.*; styles:tiles) for the login background.
EXPO_PUBLIC_BUGMAP_MAPBOX_TOKEN=
