{
  "name": "bugmap",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "design-harness": "node tools/design-harness/bin/design-harness",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tools/design-harness/test/*.test.mjs src/features/*/*.test.mjs",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web",
    "lint:figma": "node tools/design-harness/bin/design-harness lint:figma",
    "bundle:design-plugin": "node tools/design-harness/scripts/bundle-skills.mjs"
  },
  "dependencies": {
    "@rnmapbox/maps": "~10.3.18",
    "expo": "~58.0.0",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.21",
    "expo-secure-store": "~58.0.2",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^1.70.0",
    "mapbox-gl": "^3.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@rnmapbox/maps": {
      "mapbox-gl": "$mapbox-gl"
    }
  }
}
